{
  "name": "cerberus-trust-score",
  "version": "1.0.0",
  "description": "Deterministic trust score for LAX agents, with an outside score as a second opinion.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["lax", "trust", "scoring", "agents", "cerberus"],
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
}
